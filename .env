# ─── MongoDB ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://bookstoreuser:bookstoreuser@cluster0.dlfwrrz.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=dashboard
MONGODB_CLIENTS_COLLECTION=clients
MONGODB_CAMPAIGNS_COLLECTION=campaigns

# ─── Email Reports (Gmail SMTP) ───────────────────────────
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password

# ─── Meta (Facebook + Instagram) Ads ─────────────────────
# Get from: https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ─── Google Ads API ───────────────────────────────────────
# Get from: console.cloud.google.com + ads.google.com/aw/apicenter
# Note: Developer Token takes 1-3 days to get approved by Google
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEV_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── LinkedIn Marketing API ───────────────────────────────
# Get from: linkedin.com/developers → Your App → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ─── Security ─────────────────────────────────────────────
# Secret key used to secure Vercel Cron endpoint
CRON_SECRET=change-this-to-a-random-secret-string
# Key for encrypting stored integration credentials (min 32 chars)
INTEGRATION_SECRET=change-this-to-a-32-char-secret-key

# ─── App URL ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
